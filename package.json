{
  "name": "Pantry",
  "version": "0.0.1",
  "author": "Rohan Likhite <rlikhite@gmail.com>",
  "license": "MIT",
  "description": "Free JSON storage for small projects",
  "main": "src/main.ts",
  "repository": {
    "url": "https://github.com/imRohan/Pantry",
    "type": "git"
  },
  "scripts": {
    "dev": "concurrently -k \"tsc && node dist/src/main.js\" \"webpack --config webpack.dev.js\"",
    "dev-server": "tsc && node --inspect=[0.0.0.0] dist/src/main.js",
    "linter": "eslint -c .eslintrc.js --ext .ts src/",
    "fix-linting": "eslint -c .eslintrc.js --ext .ts src/ --fix",
    "tests": "jest --silent --verbose --coverage",
    "build": "tsc && webpack --config webpack.prod.js",
    "validate": "jest && eslint -c .eslintrc.js --ext .ts src/",
    "server": "tsc && node dist/src/main.js"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "\\.(ts)$": "<rootDir>/node_modules/ts-jest"
    },
    "testRegex": "./tests/.*.test.ts$",
    "modulePathIgnorePatterns": [
      "<rootDir>/dist"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/pino": "^7.0.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "babel-core": "^6.26.3",
    "babel-loader": "^10.1.1",
    "babel-preset-es2015": "^6.24.1",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.4",
    "eslint": "^10.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "html-loader": "^5.1.0",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.7",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "vue-loader": "^17.4.2",
    "vue-resource": "^1.5.1",
    "vue-template-compiler": "^2.7.16",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "ajv": "^8.20.0",
    "axios": "^1.15.2",
    "body-parser": "^2.2.2",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "deepmerge": "^4.3.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-brute": "^1.0.1",
    "express-brute-redis": "^0.0.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-logflare": "^0.5.2",
    "redis": "^5.12.1",
    "url-loader": "^4.1.1",
    "uuid": "^14.0.0",
    "vue": "^3.5.33",
    "vue-json-editor": "^1.4.3"
  }
}
